{
  "name": "@koeru/talks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dek",
    "lint": "dek lint --visual",
    "build": "dek build && dek pdf",
    "check": "tsc && dek lint --visual && dek build && bun run check:dist",
    "check:dist": "git diff --exit-code -- 'decks/*/dist/*.html' && test -z \"$(git ls-files --others --exclude-standard -- 'decks/*/dist/*.html')\""
  },
  "devDependencies": {
    "@hajimism/dek": "github:hajimism/dek#2e678c1d62bcdb69e9fe4aecbe8b06c7869be2bd",
    "@tsconfig/strictest": "2.0.8",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
