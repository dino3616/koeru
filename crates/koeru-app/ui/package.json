{
  "name": "@koeru/ui",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc --build --force && bun run check:licenses",
    "preview": "vp preview",
    "check": "vp check --fix",
    "check:ci": "vp check && bun run check:stories && bun run check:ipc && bun run test",
    "tauri": "cd .. && ui/node_modules/.bin/tauri",
    "check:licenses": "bun run scripts/check-licenses.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "test": "vp test --run --config vitest.story.config.ts",
    "check:stories": "bun run scripts/check-stories.ts",
    "check:ipc": "bun run scripts/check-ipc-calls.ts"
  },
  "dependencies": {
    "@radix-ui/colors": "3.0.0",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.57",
    "@tauri-apps/api": "2.11.1",
    "cn": "0.4.0",
    "motion": "13.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-variants": "3.3.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.5",
    "@tsconfig/bun": "1.0.11",
    "@tsconfig/strictest": "2.0.8",
    "@tsconfig/vite-react": "8.1.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "oxc-transform-react": "0.151.0",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3"
  },
