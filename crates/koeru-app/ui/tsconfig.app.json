{
  // 画面のコードと、それを描く Storybook。Bun の型を通さない。
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/vite-react/tsconfig.json"],
  "include": ["src/**/*.ts", "src/**/*.tsx", ".storybook/**/*.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": { "~/*": ["./src/*"] }
  }
}
