// KOERU プロジェクトの永続化（設計層）
//
// 要求層 KoeruProjectLifecycle を詳細化する。詳細化するのは1点だけ：
// 要求層で1手だった「テイクの確定」を、実装で必ず分かれる3手に割る。
//   録音開始（.wav.part を開く）→ ファイル確定（fsync + rename）→ DB コミット
//
// ASSUME-5: DB に載ったテイク行は、必ず確定済みの WAV を指していなければならない。
//           順序を逆にすると、ファイルの無い行が DB に残る。
//           これは要求層からは見えない、この層が背負う契約（DEC-REC-004）。
// ASSUME-6: クラッシュで失われるのは書きかけ（.wav.part）だけ。確定済みファイルと
//           コミット済みの行は残る。fsync してから rename し、rename が成功してから
//           DB へコミットすることで満たす。
//
// **[Unknown] ファイル確定後・DB コミット前にクラッシュすると、DB に載らない確定済み WAV が
// 残る。** その扱いは要件に無い（→ meta/questions/Q-REC-005）。この仕様は残ることだけを
// 認めており、回収も再利用も規定していない。DB 側に行が無いので、テイクとしては存在しない。

spec KoeruProjectStorage {
  type ListItem = 0..1
  type Count = 0..3

  const MAX_TAKES = 2
  const MAX_CRASHES = 1

  enum ItemState { Unrecorded, Adopted, AllInvalid }
  enum Handoff   { NotExported, Exported }
  enum WavFile   { NoFile, Writing, Finalized }

  state {
    item:      Map<ListItem, ItemState>,
    takes:     Map<ListItem, Count>,
    invalid:   Map<ListItem, Count>,
    finalized: Map<ListItem, Count>,
    recording: Option<ListItem>,
    wav:       WavFile,
    handoff:   Handoff,
    crashes:   Count
  }

  init {
    forall i: ListItem { item[i] = Unrecorded }
    forall i: ListItem { takes[i] = 0 }
    forall i: ListItem { invalid[i] = 0 }
    forall i: ListItem { finalized[i] = 0 }
    recording = none
    wav = NoFile
    handoff = NotExported
    crashes = 0
  }

  def complete() = forall i: ListItem { item[i] == Adopted }

  // 録音開始。ここで .wav.part を開く
  fair action start_take(i: ListItem) {
    requires recording == none
    requires wav == NoFile
    requires takes[i] < MAX_TAKES
    requires invalid[i] < MAX_TAKES
    recording = some(i)
    wav = Writing
  }

  // fsync してから .wav へ rename する。ここまでは DB に何も書かない
  fair action finalize_file() {
    requires recording is some(i)
    requires wav == Writing
    wav = Finalized
    finalized[i] = finalized[i] + 1
  }

  // ファイルが確定してからだけ DB に行を足す
  fair action commit_take() {
    requires recording is some(i)
    requires wav == Finalized
    recording = none
    wav = NoFile
    takes[i] = takes[i] + 1
    item[i] = Adopted
  }

  action discard_invalid_take() {
    requires recording is some(i)
    requires wav == Writing
    recording = none
    wav = NoFile
    invalid[i] = invalid[i] + 1
    item[i] = if takes[i] > 0 then Adopted else AllInvalid
  }

  action readopt_earlier_take(i: ListItem) {
    requires recording == none
    requires takes[i] >= 2
    item[i] = Adopted
  }

  action export_zip() {
    requires complete()
    requires recording == none
    handoff = Exported
  }

  action record_more_after_complete(i: ListItem) {
    requires complete()
    requires recording == none
    requires invalid[i] < MAX_TAKES
    invalid[i] = invalid[i] + 1
  }

  // 書きかけだけが失われる。確定済みファイルと DB の行は残る（DEC-REC-004）
  action crash_and_recover() {
    requires recording != none
    requires crashes < MAX_CRASHES
    recording = none
    wav = NoFile
    crashes = crashes + 1
  }

  // この層が背負う契約：ファイルの無いテイク行が DB にできない
  invariant NoOrphanTakeRow {
    forall i: ListItem { takes[i] <= finalized[i] }
  }

  // 確定済みで未コミットのファイルが1本あるなら、確定数はコミット数より必ず多い
  invariant FinalizedAheadOfCommitted {
    forall i: ListItem {
      (wav == Finalized and recording == some(i)) => takes[i] < finalized[i]
    }
  }

  // 書きかけも確定済みも、収録中にしか手元に無い
  invariant WavOnlyWhileRecording {
    (wav != NoFile) => recording != none
  }

  // 確定済みファイルの内訳は3つしかない。コミット済み、クラッシュで置き去りになった分、
  // そしていま確定していてまだコミットしていない1本。
  // NoOrphanTakeRow を帰納法で示すために要る補助（この領域の真理）。
  invariant CrashesBounded {
    crashes <= MAX_CRASHES
  }

  invariant FinalizedAccountedFor {
    forall i: ListItem {
      finalized[i]
        <= takes[i] + crashes
           + (if (wav == Finalized and recording == some(i)) then 1 else 0)
    }
  }

  invariant RecordingImpliesRoom {
    forall i: ListItem {
      recording == some(i) => (takes[i] < MAX_TAKES and invalid[i] < MAX_TAKES)
    }
  }

  invariant AdoptedImpliesTake {
    forall i: ListItem { item[i] == Adopted => takes[i] > 0 }
  }

  invariant AllInvalidHasNoTake {
    forall i: ListItem { item[i] == AllInvalid => takes[i] == 0 }
  }

  invariant UnrecordedHasNothing {
    forall i: ListItem { item[i] == Unrecorded => (takes[i] == 0 and invalid[i] == 0) }
  }

  trans TakesAreNeverLost {
    forall i: ListItem { takes[i] >= old(takes[i]) }
  }

  // クラッシュしても、確定済みファイルの数は減らない
  trans FinalizedFilesNeverLost {
    forall i: ListItem { finalized[i] >= old(finalized[i]) }
  }

  trans ExportOnlyWhenComplete {
    (handoff != old(handoff)) => complete()
  }

  trans ExportDoesNotChangeItems {
    (handoff != old(handoff)) => forall i: ListItem { item[i] == old(item[i]) }
  }

  trans CrashKeepsCommittedTakes {
    (crashes != old(crashes)) => forall i: ListItem { takes[i] == old(takes[i]) }
  }

  reachable CompleteWhileUnpublished {
    complete() and handoff == NotExported
  }

  terminal {
    recording == none
    and (
      (complete() and handoff == Exported)
      or forall i: ListItem { takes[i] >= MAX_TAKES or invalid[i] >= MAX_TAKES }
    )
  }
}
