# 生成物は差分と言語統計から外す。
#
# `routeTree.gen.ts` は TanStack Router が書き出す。
# **レビューで読む対象ではない**ので、既定の差分に混ぜない。
# 中身の検査は CI がしている（型検査など）。
crates/koeru-app/ui/src/routeTree.gen.ts  linguist-generated=true -diff

# 発表資料の書き出しと、dek が sync のたびに書き直す規約（`talks/`）。
# HTML は台本とスライドから作る1枚もので、読むのは元のほう。
talks/decks/*/dist/*.html  linguist-generated=true -diff
talks/AGENTS.md            linguist-generated=true
talks/.dek/*               linguist-generated=true

# 調達物は言語統計に入れない。KOERU 自身が書いた量を見えなくする。
crates/koeru-align/vendor/**   linguist-vendored=true
crates/koeru-synth/vendor/**   linguist-vendored=true
crates/koeru-align/models/**   linguist-vendored=true

# 改行を揃える。Windows でも検査が同じ結果になるように。
* text=auto eol=lf
*.png binary
*.ico binary
*.icns binary
*.pdf binary
*.wav binary
*.woff2 binary
