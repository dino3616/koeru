{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":prHourlyLimitNone"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "commitBody": "Signed-off-by: shio <dino3616@gmail.com>",
  "enabledManagers": ["cargo", "bun", "github-actions", "git-submodules", "nix", "custom.regex"],
  "git-submodules": { "enabled": true },
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "major 以外は automerge する。ライセンスは cargo deny、挙動は CI が機械判定する。落ちた PR は人が直す（DEC-PLT-033）。",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "groupName": "all non-major dependencies",
      "automerge": true
    },
    {
      "description": "major は PR を出さない。Dependency Dashboard に載せ、人が着手するものを選ぶ（DEC-PLT-033）。",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": null,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "submodule は同梱の C++ とモデル（DEC-PLT-016, DEC-ALN-012）。アライメントと合成の劣化は CI で捕まらない（EVID-ALN-001）ので automerge しない。",
      "matchManagers": ["git-submodules"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": null
    },
    {
      "description": "Tauri と Radix と TanStack は面で動くので、それぞれまとめて上げる。",
      "matchPackageNames": ["/^@tauri-apps//", "/^tauri/"],
      "groupName": "tauri"
    },
    { "matchPackageNames": ["/^@radix-ui//"], "groupName": "radix" },
    { "matchPackageNames": ["/^@tanstack//"], "groupName": "tanstack" }
  ],
  "customManagers": [
    {
      "description": "fslc は GitHub Release のバイナリ。flake.nix の版を追う。SHA-256 は nix-hash-fix ワークフローが当てる（DEC-PLT-033）。",
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["fslcVersion\\s*=\\s*\"(?<currentValue>v[0-9][0-9.]*)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "ymm-oss/fsl"
    }
  ],
  "ignoreDeps": [],
  "vulnerabilityAlerts": { "labels": ["security"], "schedule": ["at any time"] }
}
