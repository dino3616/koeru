{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", ":prHourlyLimitNone"],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "commitBody": "Signed-off-by: shio <dino3616@gmail.com>",
  "enabledManagers": ["cargo", "bun", "github-actions", "git-submodules", "nix", "custom.regex"],
  "git-submodules": { "enabled": true },
  "nix": { "enabled": true },
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "major 以外は automerge する。ライセンスは cargo deny、挙動は CI が機械判定する。落ちた PR は人が直す（DEC-PLT-033）。",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "groupName": "all non-major dependencies",
      "automerge": true
    },
    {
      "description": "major は PR を出さない。Dependency Dashboard に載せ、人が着手するものを選ぶ（DEC-PLT-033）。",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": null,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "submodule は同梱の C++ とモデル（DEC-PLT-016, DEC-ALN-012）。アライメントと合成の劣化は CI で捕まらない（EVID-ALN-001）ので automerge しない。",
      "matchManagers": ["git-submodules"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": null
    },
    {
      "description": "Tauri と Radix と TanStack は面で動くので、それぞれまとめて上げる。",
      "matchPackageNames": ["/^@tauri-apps//", "/^tauri/"],
      "groupName": "tauri"
    },
    {
      "description": "specta・specta-typescript・tauri-specta は上流が同じ世代で版を揃えて出し、互いを `=` で固定している。別々の PR で上げると必ず解けない。上の tauri の組より後ろに置いて、tauri-specta をこちらへ寄せる。",
      "matchPackageNames": ["specta", "specta-typescript", "tauri-specta"],
      "groupName": "specta"
    },
    { "matchPackageNames": ["/^@radix-ui//"], "groupName": "radix" },
    {
      "description": "Playwright のブラウザは nixpkgs から出る（DEC-PLT-033）。npm 側だけを上げると CI の版の突き合わせで必ず落ちるので、PR を出さない。nixpkgs が上がった lock file maintenance の PR の中で、playwright-follow ワークフローが npm 側を揃える。",
      "matchManagers": ["bun"],
      "matchDepNames": ["playwright"],
      "enabled": false
    },
    { "matchPackageNames": ["/^@tanstack//"], "groupName": "tanstack" },
    {
      "description": "vite-plus は同梱の vitest と同じ版の vitest と @vitest/browser-playwright を peer に求め、vite の別名も同じ版の core を指す。1つだけ上がると install が解けない（DEC-PLT-022）。major でも束で出す。",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core", "vitest", "@vitest/browser-playwright"],
      "groupName": "vite-plus"
    },
    {
      "description": "OpenUtau の alpha は prerelease（DEC-SYN-010 の層B）。既定の stable とは別に追う——綴りが変わるならそちらに先に出る。",
      "matchDepTypes": ["alpha"],
      "matchPackageNames": ["openutau/OpenUtau"],
      "ignoreUnstable": false
    },
    {
      "description": "OpenUtau は phonemizer の突合相手（DEC-SYN-010 の層B）。版が上がると期待値のキャッシュが作り直され、綴りが変われば CI が落ちる。通れば automerge してよい。指紋は nix-hash-fix ワークフローが当てる。",
      "matchPackageNames": ["openutau/OpenUtau"],
      "automerge": true,
      "groupName": null,
      "labels": ["dependencies", "phonemizer"]
    }
  ],
  "customManagers": [
    {
      "description": "fslc は GitHub Release のバイナリ。flake.nix の版を追う。SHA-256 は nix-hash-fix ワークフローが当てる（DEC-PLT-033）。",
      "customType": "regex",
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["fslcVersion\\s*=\\s*\"(?<currentValue>v[0-9][0-9.]*)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "ymm-oss/fsl"
    },
    {
      "description": "OpenUtau は綴りの突合相手（DEC-SYN-010）。チャンネルごとに1件。SHA-256 は nix-hash-fix ワークフローが当てる。",
      "customType": "regex",
      "managerFilePatterns": ["/^crates/koeru-core/fixtures/phonemizer-parity/openutau\\.toml$/"],
      "matchStrings": ["name = \"(?<depType>[a-z]+)\"\\nversion = \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "openutau/OpenUtau"
    }
  ],
  "ignoreDeps": [],
  "vulnerabilityAlerts": { "labels": ["security"], "schedule": ["at any time"] }
}
